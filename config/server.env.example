# Copy to .env.server. Environment variables override values in this file.
MARSI_OLLAMA_URL=http://127.0.0.1:11434
MARSI_MODEL=qwen3:1.7b
# Generate a token: python3 -c 'import secrets; print(secrets.token_hex(32))'
MARSI_TOKEN=
MARSI_CPU_THREADS=3
MARSI_TIMEOUT=180
MARSI_DATABASE=data/companion.sqlite3
MARSI_WHISPER_MODEL=tiny
# Leave blank for language detection; use en or de for a fixed language.
MARSI_WHISPER_LANGUAGE=
# Set after downloading a voice, with its .onnx.json alongside it.
MARSI_PIPER_MODEL=models/piper/en_US-lessac-medium.onnx
# Daily art, a sermon every 2-3 days, and a local morning greeting.
MARSI_OBSERVANCES=true
# Match MARSI_SESSION on your usual Pi; other sessions remain independent.
MARSI_COMPANION_SESSION=pi
# Uses the Ubuntu machine's local timezone; set both machines correctly.
MARSI_MORNING_HOUR=7
