# Copy to .env.pi. Use your Ubuntu server's reserved LAN IP address.
MARSI_SERVER_URL=http://YOUR_SERVER_IP:8765
# Copy the same token from the server; never commit it.
MARSI_TOKEN=
MARSI_SESSION=pi
MARSI_SPEAK=true
MARSI_RITUALS=true
MARSI_RITUAL_SPEECH=false
# Sermons and morning greetings can speak; daily art is displayed silently.
MARSI_OBSERVANCE_SPEECH=true
# The morning greeting may speak at 07:00 despite the quiet-hour interval.
MARSI_MORNING_SPEECH_DURING_QUIET=true
MARSI_RITUAL_MIN_SECONDS=600
MARSI_RITUAL_MAX_SECONDS=1200
# Uses the Pi's local clock; equal start/end disables quiet hours.
MARSI_QUIET_START=22
MARSI_QUIET_END=8
# Blank uses the default input device; an index or exact name is also accepted.
MARSI_MIC_DEVICE=
MARSI_MIC_RATE=16000
# Optional ALSA playback device: plughw:1,0 or pipewire (Bluetooth guide).
# Blank uses default.
MARSI_SPEAKER_DEVICE=
