# Copy to .env.pi. Use your Ubuntu server's reserved LAN IP address.
MARSI_SERVER_URL=http://YOUR_SERVER_IP:8765
# Copy the same token from the server; never commit it.
MARSI_TOKEN=
MARSI_SESSION=pi
MARSI_SPEAK=true
MARSI_RITUALS=true
MARSI_RITUAL_SPEECH=false
# The daily sermon and morning greeting can speak. Interludes are silent.
MARSI_OBSERVANCE_SPEECH=true
# The morning greeting may speak at 07:00 despite the quiet-hour interval.
MARSI_MORNING_SPEECH_DURING_QUIET=true
MARSI_RITUAL_MIN_SECONDS=600
MARSI_RITUAL_MAX_SECONDS=1200
# Uses the Pi's local clock; equal start/end disables quiet hours.
MARSI_QUIET_START=22
MARSI_QUIET_END=8
# Local-data interludes: random 30..90 minutes, after at least 2 minutes idle.
MARSI_INTERLUDE_MIN_SECONDS=1800
MARSI_INTERLUDE_MAX_SECONDS=5400
MARSI_INTERLUDE_IDLE_SECONDS=120
MARSI_INTERLUDE_MIN_DURATION=15
MARSI_INTERLUDE_MAX_DURATION=30
MARSI_INTERLUDE_CHIRP=false
# Stop movement and show complete replies immediately when true.
MARSI_REDUCED_MOTION=false
# Moving block-cursor reveal for new Marsi replies; history opens instantly.
MARSI_TYPEWRITER=true
# Blank uses the default input device; an index or exact name is also accepted.
MARSI_MIC_DEVICE=
MARSI_MIC_RATE=16000
# Optional ALSA playback device: plughw:1,0 or pipewire (Bluetooth guide).
# Blank uses default.
MARSI_SPEAKER_DEVICE=
# Requested ALSA buffer/period in milliseconds; hardware negotiates actual values.
# More buffering can help a busy Pi avoid playback underruns.
MARSI_PLAYBACK_BUFFER_MS=1000
MARSI_PLAYBACK_PERIOD_MS=100
# Before opening the display, test these settings on the Pi:
# .venv-pi/bin/python -m marsi_local.audio --check
